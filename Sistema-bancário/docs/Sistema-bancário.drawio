        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Cliente {\n        -String nome\n        -String cpf\n        -List~Conta~ contas\n    }\n    class Conta {\n        &lt;&lt;abstract&gt;&gt;\n        #int numero\n        #Cliente titular\n        #double saldo\n        #List~Transacao~ historico\n        +depositar(valor)\n        +sacar(valor)*\n    }\n    class ContaCorrente {\n        -double limiteChequeEspecial\n        +sacar(valor)\n        +calcularImposto() double\n    }\n    class ContaPoupanca {\n        -double taxaJuros\n        +sacar(valor)\n        +renderJuros()\n    }\n    class Transacao {\n        -TipoTransacao tipo\n        -double valor\n        -LocalDateTime data\n    }\n    class TipoTransacao {\n        &lt;&lt;enumeration&gt;&gt;\n        DEPOSITO\n        SAQUE\n        TRANSFERENCIA\n    }\n    class Transacionavel {\n        &lt;&lt;interface&gt;&gt;\n        +depositar(valor)\n        +sacar(valor)\n    }\n    class Tributavel {\n        &lt;&lt;interface&gt;&gt;\n        +calcularImposto() double\n    }\n    class ContaRepository {\n        &lt;&lt;interface&gt;&gt;\n        +salvar(conta)\n        +buscarPorNumero(numero) Conta\n        +listarTodas() List~Conta~\n    }\n    class ContaRepositoryMemoria {\n        -Map~Integer, Conta~ contas\n    }\n    class ContaService {\n        -ContaRepository repository\n        +criarConta()\n        +depositar()\n        +sacar()\n        +transferir()\n    }\n    class ContaController {\n        -ContaService service\n        +criarConta()\n        +depositar()\n        +sacar()\n        +transferir()\n        +consultarSaldo()\n    }\n\n    Cliente \&quot;1\&quot; o-- \&quot;many\&quot; Conta : possui\n    Conta \&quot;1\&quot; *-- \&quot;many\&quot; Transacao : registra\n    Conta &lt;|-- ContaCorrente\n    Conta &lt;|-- ContaPoupanca\n    Conta ..|&gt; Transacionavel\n    ContaCorrente ..|&gt; Tributavel\n    ContaRepositoryMemoria ..|&gt; ContaRepository\n    ContaService --&gt; ContaRepository\n    ContaController --&gt; ContaService&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
